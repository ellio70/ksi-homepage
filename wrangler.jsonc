{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sentinai",
  "compatibility_date": "2026-04-13",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // CMS KV — stores content overrides (i18n + image map) edited via /admin
  // Production KV namespace: sentinai-cms-kv (created via Cloudflare API)
  "kv_namespaces": [
    {
      "binding": "CMS_KV",
      "id": "462f4befbf2a43158db462d22d1eb876"
    }
  ]
}